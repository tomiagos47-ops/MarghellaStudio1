{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "VERCEL_STATIC_EXPORT=1 npx next build",
  "outputDirectory": "out",
  "framework": null,
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(icon|apple-icon|opengraph-image)",
      "headers": [
        {
          "key": "Content-Type",
          "value": "image/png"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    }
  ]
}
